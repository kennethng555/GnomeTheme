[control-center]
last-panel='background'
window-state=(960, 640, false)

[desktop/app-folders]
folder-children=['Utilities', 'YaST', 'Pardus']

[desktop/app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[desktop/app-folders/folders/Utilities]
apps=['gnome-abrt.desktop', 'gnome-system-log.desktop', 'nm-connection-editor.desktop', 'org.gnome.baobab.desktop', 'org.gnome.Connections.desktop', 'org.gnome.DejaDup.desktop', 'org.gnome.Dictionary.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.Evince.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.fonts.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.seahorse.Application.desktop', 'org.gnome.tweaks.desktop', 'org.gnome.Usage.desktop', 'vinagre.desktop']
categories=['X-GNOME-Utilities']
name='X-GNOME-Utilities.directory'
translate=true

[desktop/app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[desktop/background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///home/a/.local/share/backgrounds/2026-09-14-03-48-10-cityscape-serenity-with-feline-companion-backiee-8K.jpg'
picture-uri-dark='file:///home/a/.local/share/backgrounds/2026-09-14-03-48-10-cityscape-serenity-with-feline-companion-backiee-8K.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[desktop/calendar]
show-weekdate=true

[desktop/datetime]
automatic-timezone=true

[desktop/input-sources]
sources=[('xkb', 'us')]
xkb-options=@as []

[desktop/interface]
clock-format='12h'
clock-show-weekday=true
color-scheme='prefer-dark'
enable-animations=true
enable-hot-corners=false
gtk-theme='Colloid-Pink-Dark'
icon-theme='Papirus-Dark'

[desktop/notifications]
application-children=['firefox-firefox']

[desktop/notifications/application/firefox-firefox]
application-id='firefox_firefox.desktop'

[desktop/peripherals/keyboard]
numlock-state=true

[desktop/screensaver]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///home/a/.local/share/backgrounds/2026-09-14-03-48-10-cityscape-serenity-with-feline-companion-backiee-8K.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[desktop/wm/preferences]
button-layout=':minimize,maximize,close'
num-workspaces=2

[evolution-data-server]
migrated=true

[mutter]
dynamic-workspaces=true
overlay-key='Super_L'

[nautilus/preferences]
default-folder-viewer='icon-view'
migrated-gtk-settings=true
search-filter-time-type='last_modified'

[nautilus/window-state]
initial-size=(890, 550)

[settings-daemon/plugins/color]
night-light-enabled=false

[shell]
app-picker-layout=[{'byobu.desktop': <{'position': <0>}>, 'conky.desktop': <{'position': <1>}>, 'com.mattjakeman.ExtensionManager.desktop': <{'position': <2>}>, 'htop.desktop': <{'position': <3>}>, 'gnome-language-selector.desktop': <{'position': <4>}>, 'gnome-session-properties.desktop': <{'position': <5>}>, 'info.desktop': <{'position': <6>}>, 'vim.desktop': <{'position': <7>}>, 'org.gnome.Settings.desktop': <{'position': <8>}>, 'yelp.desktop': <{'position': <9>}>, 'Utilities': <{'position': <10>}>, 'firefox_firefox.desktop': <{'position': <11>}>}]
disabled-extensions=['dash-in-panel@fthx']
enabled-extensions=['blur-my-shell@aunetx', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'just-perfection-desktop@just-perfection', 'search-light@icedman.github.com', 'dash-to-panel@jderose9.github.com', 'dash-to-dock@micxgx.gmail.com', 'arcmenu@arcmenu.com']
favorite-apps=['org.gnome.Terminal.desktop', 'firefox_firefox.desktop', 'org.gnome.Nautilus.desktop']
welcome-dialog-last-shown-version='46.0'

[shell/extensions/arcmenu]
dash-to-panel-standalone=false
hide-overview-on-arcmenu-open=false
hide-overview-on-startup=false
menu-button-appearance='Icon'
menu-layout='brisk'
prefs-visible-page=0
search-entry-border-radius=(true, 25)
update-notifier-project-version=73

[shell/extensions/blur-my-shell]
rounded-blur-found=false
settings-version=2

[shell/extensions/blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[shell/extensions/blur-my-shell/applications]
blur=true
blur-on-overview=false
corner-when-maximized=true
dynamic-opacity=false
enable-all=true
opacity=225
pipeline='pipeline_default'
static-blur=true

[shell/extensions/blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[shell/extensions/blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0

[shell/extensions/blur-my-shell/dash-to-panel]
blur-original-panel=false

[shell/extensions/blur-my-shell/lockscreen]
pipeline='pipeline_default'

[shell/extensions/blur-my-shell/overview]
pipeline='pipeline_default'
style-components=3

[shell/extensions/blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
force-light-text=false
pipeline='pipeline_default'
sigma=30

[shell/extensions/blur-my-shell/screenshot]
pipeline='pipeline_default'

[shell/extensions/blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[shell/extensions/dash-to-dock]
apply-custom-theme=false
background-opacity=0.80000000000000004
custom-theme-shrink=true
dash-max-icon-size=32
disable-overview-on-startup=false
dock-fixed=false
dock-position='BOTTOM'
height-fraction=0.90000000000000002
preferred-monitor=-2
preferred-monitor-by-connector='Virtual-1'

[shell/extensions/dash-to-panel]
animate-appicon-hover-animation-extent={'RIPPLE': 4, 'PLANK': 4, 'SIMPLE': 1}
dot-position='BOTTOM'
dot-style-focused='DOTS'
extension-version=73
global-border-radius=5
hotkeys-overlay-combo='TEMPORARILY'
intellihide=false
panel-anchors='{"unknown-unknown":"MIDDLE"}'
panel-element-positions='{"unknown-unknown":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centered"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}]}'
panel-lengths='{"unknown-unknown":100}'
panel-positions='{"unknown-unknown":"TOP"}'
panel-sizes='{"unknown-unknown":32}'
prefs-opened=false
scroll-panel-action='NOTHING'
show-apps-icon-file=''
trans-panel-opacity=0.40000000000000002
trans-use-border=false
trans-use-custom-bg=false
trans-use-custom-gradient=false
trans-use-custom-opacity=true
trans-use-dynamic-opacity=false
window-preview-title-position='TOP'

[shell/extensions/just-perfection]
accessibility-menu=true
activities-button=false
background-menu=true
clock-menu-position=0
controls-manager-spacing-size=0
dash=true
